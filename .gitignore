*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Debug y crash reports
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini

# Plugins autogenerados
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

LightingData.asset
