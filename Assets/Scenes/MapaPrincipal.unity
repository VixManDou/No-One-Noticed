  m_Script: {fileID: 11500000, guid: 5872b2532b345b44fbd5dc00704cb7bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  nombre: El agricultor
  dialogo:
  - "\xBFBuscas algo? No suelo ver caras nuevas por estos caminos."
  - "Aqu\xED todos nos conocemos. Si alguien llega, tarde o temprano alguien pregunta por \xE9l."
  - No te recomiendo alejarte demasiado del camino principal. Hay terrenos que ya nadie trabaja.
  - "Hace a\xF1os que nadie se acerca a ciertos sitios. Y no, no es por falta de tiempo."
  - "Tres lugares, tres caminos y ninguna raz\xF3n para visitarlos. As\xED estamos mejor."
  dialogoRepetido:
  - "Sigo ocupado. No tengo mucho m\xE1s que decirte."
  mensajeInteraccion: Presiona E para hablar
  velocidadTexto: 40
  sonidoVoz: {fileID: 0}
  congelarJugador: 1
  mirarAlJugador: 1
  velocidadGiro: 6
