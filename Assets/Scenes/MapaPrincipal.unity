  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5872b2532b345b44fbd5dc00704cb7bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  nombre: El vigilante
  dialogo:
  - "Alto. No recuerdo haberte visto antes. \xBFCu\xE1l es tu asunto en el pueblo?"
  - "No hay mucho que vigilar por aqu\xED. La gente conoce sus l\xEDmites y procura respetarlos."
  - "Hay caminos que no deber\xEDas tomar. No est\xE1n cerrados, pero eso no significa que debas recorrerlos."
  - "Tres lugares permanecen fuera de las rutas habituales. No est\xE1n abandonados, aunque eso es lo que todos dicen."
  - "Te dar\xE9 un consejo: deja de preguntar por esos sitios. La curiosidad puede meterte en problemas que no necesitas."
  dialogoRepetido:
  - "a hablamos de esto. Contin\xFAa con tus asuntos."
  mensajeInteraccion: Presiona E para hablar
  velocidadTexto: 40
  sonidoVoz: {fileID: 0}
  congelarJugador: 1
  mirarAlJugador: 1
  velocidadGiro: 6
  tagJugador: Player
  alTerminarDialogo:
    m_PersistentCalls:
      m_Calls: []
  eventoSoloUnaVez: 1
